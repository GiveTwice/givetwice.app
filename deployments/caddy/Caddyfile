# GiveTwice Production Caddyfile for FrankenPHP + Laravel Octane
# Caddy 2 syntax (FrankenPHP is built on Caddy 2)
#
# Usage:
#   php artisan octane:start --server=frankenphp --host=0.0.0.0 --port=443 \
#       --caddyfile=deployments/caddy/Caddyfile --https
#
# Or run FrankenPHP directly:
#   frankenphp run --config deployments/caddy/Caddyfile

# Global options
{
    # Admin API (for graceful restarts, metrics)
    admin localhost:2019

    # Skip installing internal CA to system trust store (not needed for Cloudflare origin)
    skip_install_trust

    # Cloudflare handles HTTP/3 at the edge
    servers {
        protocols h1 h2
    }

    # FrankenPHP's embedded PHP reads no php.ini here, so it runs on PHP's built-in
    # defaults. Those defaults are unsafe for two advisories from 2026-11-19.
    frankenphp {
        # Keeps arguments out of backtraces. With them included, a fatal error inside
        # __call() or __callStatic() (Laravel facades) can lead to remote code
        # execution on PHP 8.5.12 and older (CVE-2026-129474).
        php_ini zend.exception_ignore_args 1
        # Laravel does not use PHP's native sessions, so the upload progress feature
        # is unused. It is the input path for CVE-2026-115560 and CVE-2026-126714.
        php_ini session.upload_progress.enabled 0
    }
}

# Redirect www to non-www (both HTTP and HTTPS)
www.givetwice.app {
    tls internal
    redir https://givetwice.app{uri} permanent
}

# Main site configuration
givetwice.app {
    # Self-signed cert - Cloudflare handles public TLS
    # Set Cloudflare SSL/TLS mode to "Full" (not "Full (Strict)")
    tls internal

    # Document root
    root * /home/givetwice/givetwice.app/current/public

    # Compression: zstd > brotli > gzip (in order of preference)
    encode zstd br gzip

    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Enable XSS filter
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS (enable after confirming HTTPS works)
        # Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Remove server identification
        -Server
        -X-Powered-By
    }

    # Static assets: serve directly with aggressive caching.
    # The file matcher only matches files that exist on disk. Without it, a missing
    # image such as /og-image/{hash}.jpeg gets an empty 404 here and never reaches
    # Laravel, which is what generates those images on the first request.
    @static {
        file
        path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.webp *.avif
        path *.woff *.woff2 *.ttf *.eot *.otf
        path *.mp4 *.webm *.ogg *.mp3 *.wav
        path *.pdf *.zip *.tar *.gz
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Build assets (Vite): immutable cache headers
    @build {
        path /build/*
    }
    handle @build {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Favicon and robots.txt: shorter cache
    @shortcache {
        path /favicon.ico /robots.txt /sitemap.xml
    }
    handle @shortcache {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # Laravel Reverb WebSocket proxy
    # /app - WebSocket connections (Laravel Echo clients)
    # /apps - API requests (broadcasting from backend)
    @reverb {
        path /app/*
        path /apps/*
    }
    handle @reverb {
        reverse_proxy localhost:6001
    }

    # PHP handling via FrankenPHP
    php_server {
        # Laravel's front controller pattern
        try_files {path} index.php
        # Don't follow symlinks for root (security)
        resolve_root_symlink false
    }

    # Logging
    log {
        output file /var/log/caddy/givetwice-access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}
