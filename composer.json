{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "givetwice/product-info-fetcher": "^0.5.1",
        "jenssegers/agent": "^2.6.4",
        "lab404/laravel-impersonate": "^1.7.8",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.40",
        "laravel/horizon": "^5.50.1",
        "laravel/octane": "^2.23",
        "laravel/reverb": "^1.12",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0.2",
        "spatie/laravel-activitylog": "^5.1.4",
        "spatie/laravel-health": "^1.41",
        "spatie/laravel-medialibrary": "^11.23.12",
        "spatie/laravel-og-image": "^1.3.2",
        "spatie/laravel-schedule-monitor": "^4.3.3",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-slack-alerts": "^1.9",
        "spatie/security-advisories-health-check": "^1.4",
        "symfony/http-client": "^8.1.11",
        "symfony/postmark-mailer": "^8.1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.14",
        "laravel-lang/lang": "^15.37.7",
        "laravel/boost": "^2.10.4",
        "laravel/envoy": "^2.12.2",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "mattiasgeniar/phpunit-query-count-assertions": "^1.4.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.5",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^13.4.5",
        "spatie/laravel-ray": "^1.43.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "yarn install",
            "yarn build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan octane:start --watch --port=8000\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"yarn dev\" --names=octane,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
